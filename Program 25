records = [
    {"hash": "ABC", "prev": "0", "time": 10},
    {"hash": "DEF", "prev": "ABC", "time": 12},
    {"hash": "GHI", "prev": "DEF", "time": 15}
]

valid = True

for i in range(1, len(records)):
    if records[i]["prev"] != records[i-1]["hash"]:
        valid = False

    if records[i]["time"] < records[i-1]["time"]:
        valid = False

if valid:
    print("Chain of Custody: VALID")
    print("Hash chain is unbroken.")
    print("Timestamps are in correct order.")
else:
    print("Chain of Custody: INVALID")
