def identify_application(scenario):
    scenario = scenario.lower()

    application_keywords = {
        "Banking Fraud Prevention": [
            "bank", "credit card", "transaction",
            "fraud", "payment", "account takeover"
        ],
        "Healthcare Data Protection": [
            "hospital", "healthcare", "patient",
            "medical", "health record", "ehr"
        ],
        "E-Commerce Fraud Prevention": [
            "e-commerce", "online shopping", "retailer",
            "customer order", "checkout", "online payment"
        ],
        "Cloud Security": [
            "cloud", "cloud storage", "virtual machine",
            "saas", "paas", "iaas"
        ],
        "Telecommunication Security": [
            "telecom", "mobile network", "subscriber",
            "5g", "4g", "cellular"
        ]
    }

    scores = {}

    for area, keywords in application_keywords.items():
        scores[area] = sum(
            1 for keyword in keywords if keyword in scenario
        )

    best_area = max(scores, key=scores.get)

    if scores[best_area] == 0:
        return "No specific application area identified."

    return best_area


scenario = input("Enter the business scenario: ")
print("Most Relevant Threat Intelligence Application Area:")
print(identify_application(scenario))
